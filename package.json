{
  "name": "fetih-turkiye",
  "version": "1.0.0",
  "description": "Fetih Türkiye - Gerçek Zamanlı Çok Oyunculu Bilgi Yarışması ve Harita Fethi Oyunu",
  "main": "server/dist/server/src/server.js",
  "scripts": {
    "dev:server": "tsx watch server/src/server.ts",
    "dev:client": "vite client --host",
    "dev": "node server/scripts/dev-runner.js",
    "build:client": "vite build client",
    "build:server": "tsc -p server/tsconfig.json",
    "build": "npm run build:client && npm run build:server",
    "start": "node server/dist/server/src/server.js",
    "test": "vitest run server/tests",
    "verify:map": "node server/scripts/build-map-data.js",
    "verify:questions": "node server/scripts/compile-questions.js && node server/scripts/verify-questions.js",
    "verify": "npm run verify:map && npm run verify:questions",
    "sim": "tsx server/scripts/simulate-bots.ts"
  },
  "keywords": [
    "multiplayer",
    "turkey",
    "quiz",
    "conquest",
    "strategy",
    "socketio",
    "pwa"
  ],
  "author": "RynixTR01",
  "license": "MIT",
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
